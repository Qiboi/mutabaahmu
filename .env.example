# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mutabaah?retryWrites=true&w=majority
MONGODB_URI=

# Auth.js v5 secret - generate with: npx auth secret
AUTH_SECRET=

# Vercel Blob (student photos, school logo) - only needed once that feature is built
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
